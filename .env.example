# App
NODE_ENV=development
PORT=3001
# Browser-facing API URL. Use http://localhost:3001 for local dev on this
# machine. For LAN/mobile testing (e.g. an iPhone on the same Wi-Fi), run
# `bash scripts/dev-lan.sh` instead of editing this file.
VITE_API_URL=http://localhost:3001

# Database
# connection_limit=20 sets the Prisma connection pool size.
# pool_timeout=10 sets how long to wait for a connection from the pool (seconds).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silent_review?schema=public&connection_limit=20&pool_timeout=10

# Redis
REDIS_URL=redis://localhost:6379

# Secrets (required for auth features; not needed for foundation health check)
JWT_SECRET=
JWT_REFRESH_SECRET=

# OAuth - optional for local development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# AWS - optional for local development
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=silent-review-uploads

# App URLs
# Allowed CORS/Socket.IO origin. Use http://localhost:5173 for local dev.
# `bash scripts/dev-lan.sh` overrides this with the machine's LAN IP for
# phone-on-Wi-Fi testing.
WEB_APP_URL=http://localhost:5173

# Video validation and moderation
VIDEO_MODERATION_ENABLED=true
VIDEO_MIN_RESOLUTION=480
VIDEO_MIN_FPS=24
VIDEO_MODERATION_FRAME_COUNT=5
VIDEO_MODERATION_SKIN_THRESHOLD=0.35
VIDEO_MODERATION_FAIL_CLOSED=false
