generator client {
  provider      = "prisma-client-js"
  // The production image is Alpine (musl) with OpenSSL 3; without this target
  // Prisma ships the OpenSSL 1.1 engine and crashes with libssl.so.1.1 missing.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  role          UserRole @default(USER)

  // Stats
  totalReviews       Int       @default(0)
  totalGuesses       Int       @default(0)
  totalPoints        Int       @default(0)
  totalLikes         Int       @default(0)
  streakDays         Int       @default(0)
  longestStreak      Int       @default(0)
  freezeHeld         Int       @default(0)
  lastFreezeEarnedAt DateTime?
  lastActiveAt       DateTime?

  // Preferences stored as JSONB for flexibility
  preferences Json? @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviews                 Review[]
  guesses                 Guess[]
  likes                   Like[]
  comments                Comment[]
  shareEvents             ShareEvent[]
  ownedProducts           Product[]              @relation("OwnedProducts")
  followers               Follow[]               @relation("following")
  following               Follow[]               @relation("follower")
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  achievements            UserAchievement[]
  notifications           Notification[]
  invitesSent             Invite[]               @relation("InvitesSent")
  invitesAccepted         Invite[]               @relation("InvitesAccepted")
  challengesCreated       Challenge[]            @relation("ChallengesCreated")
  challengesSent          Challenge[]            @relation("ChallengesSent")
  challengesReceived      Challenge[]            @relation("ChallengesReceived")
  challengeParticipations ChallengeParticipant[]
  notificationPreference  UserNotificationPreference?

  @@index([deletedAt])
  @@index([role])
  @@index([totalPoints])
  @@index([streakDays])
  @@index([lastActiveAt])
}

enum UserRole {
  USER
  CREATOR
  MERCHANT
  MODERATOR
  ADMIN
}

model OAuthAccount {
  id           String    @id @default(uuid())
  provider     String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  @@unique([provider, providerId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id           String   @id @default(uuid())
  name         String
  brand        String?
  category     String
  description  String?
  imageUrl     String?
  affiliateUrl String?
  tags         String[]
  metadata     Json?    @default("{}")

  // The merchant account that owns this product (assigned by an admin).
  ownerId String?
  owner   User?   @relation("OwnedProducts", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Full-text search vector maintained by application layer or trigger
  searchVector String?

  // Moderation queue for newly added products
  moderationStatus ProductModerationStatus @default(APPROVED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviews Review[]

  @@index([category])
  @@index([brand])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([searchVector])
  @@index([tags])
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  videoUrl      String
  thumbnailUrl  String?
  duration      Float // in seconds
  format        String // e.g. "video/webm", "video/mp4"
  rating        Int
  caption       String?
  productTag    String?
  // When false, the comment box is hidden and the comments API rejects new comments.
  allowComments Boolean @default(true)

  // Engagement metrics (denormalized for fast feed queries)
  viewCount       Int @default(0)
  completeCount   Int @default(0)
  likeCount       Int @default(0)
  guessCount      Int @default(0)
  commentCount    Int @default(0)
  shareCount      Int @default(0)
  exactGuessCount Int @default(0)

  // Duet reference: this review is a reaction to another review.
  duetOfId String?
  duetOf   Review?  @relation("ReviewDuet", fields: [duetOfId], references: [id], onDelete: SetNull)
  duets    Review[] @relation("ReviewDuet")

  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  guesses         Guess[]
  likes           Like[]
  comments        Comment[]
  shareEvents     ShareEvent[]
  videoModeration VideoModeration?
  dailyDrops      DailyDrop[]
  Challenge       Challenge[]
  contentCuration ContentCuration[]

  @@index([userId])
  @@index([productId])
  @@index([status, deletedAt])
  @@index([status, deletedAt, createdAt])
  @@index([status, deletedAt, guessCount, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([likeCount, createdAt])
  @@index([duetOfId])
}

model DailyDrop {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  isOverride Boolean  @default(false)
  createdAt  DateTime @default(now())

  guesses Guess[]

  @@index([reviewId])
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  UNDER_REVIEW
}

model VideoModeration {
  id          String           @id @default(uuid())
  reviewId    String           @unique
  review      Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  status      ModerationStatus @default(PENDING)
  score       Float?
  reasons     String[]
  frameScores Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, updatedAt])
}

enum ModerationStatus {
  PENDING
  PASS
  REVIEW
  REJECT
}

model Guess {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId      String
  review        Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  dailyDropId   String?
  dailyDrop     DailyDrop? @relation(fields: [dailyDropId], references: [id], onDelete: SetNull)
  guessedRating Int
  isCorrect     Boolean    @default(false)
  score         Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([userId, reviewId])
  @@unique([userId, dailyDropId])
  @@index([reviewId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([dailyDropId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId, createdAt])
}

model Comment {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[] @relation("CommentReplies")
  text      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([reviewId])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
}

model ShareEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  provider    String
  utmCampaign String?
  utmContent  String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
  @@index([provider, createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Achievement {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  iconUrl     String?
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?            @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  GUESS
  ACHIEVEMENT
  CHALLENGE
  CHALLENGE_RECEIVED
  CHALLENGE_BEAT
  SYSTEM
  STREAK_AT_RISK
  DAILY_DROP
}

model ContentCuration {
  id              String            @id @default(uuid())
  reviewId        String
  review          Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  guessabilityScore Float
  status          CurationStatus    @default(CANDIDATE)
  scheduledDate   DateTime?         @db.Date
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, guessabilityScore])
  @@index([scheduledDate])
  @@index([reviewId])
}

enum CurationStatus {
  CANDIDATE
  APPROVED
  REJECTED
  SCHEDULED
}

model UserNotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLive         Boolean  @default(true)
  streakAtRisk      Boolean  @default(true)
  challengeReceived Boolean  @default(true)
  scoreBeaten       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rules       Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id         String   @id @default(uuid())
  type       String
  userId     String?
  sessionId  String?
  channel    String   @default("organic")
  properties Json?    @default("{}")
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([channel, createdAt])
  @@index([createdAt])
}

model MetricSnapshot {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  metric     String
  dimension  String   @default("")
  value      Float
  sampleSize Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, metric, dimension])
  @@index([date, metric])
}

model Invite {
  id         String    @id @default(uuid())
  code       String    @unique
  inviterId  String
  inviter    User      @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId  String?
  invitee    User?     @relation("InvitesAccepted", fields: [inviteeId], references: [id], onDelete: SetNull)
  clicks     Int       @default(0)
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([inviterId])
  @@index([inviteeId])
}

model Challenge {
  id   String        @id @default(uuid())
  type ChallengeType @default(GENERIC)

  // Generic leaderboard challenges use creatorId + participants.
  creatorId    String
  creator      User                   @relation("ChallengesCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  participants ChallengeParticipant[]

  // Per-video head-to-head challenges use challengerId/challengedId + reviewId.
  // For per-video rows creatorId is set equal to challengerId for backwards compatibility.
  reviewId        String?
  review          Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  challengerId    String?
  challenger      User?   @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: Cascade)
  challengedId    String?
  challenged      User?   @relation("ChallengesReceived", fields: [challengedId], references: [id], onDelete: Cascade)
  challengerScore Int     @default(0)
  challengedScore Int     @default(0)
  // Per-video challenges need to distinguish "score of 0" from "has not played yet".
  challengerSubmittedAt DateTime?
  challengedSubmittedAt DateTime?

  // Rematch chain: a completed challenge can spawn a follow-up on a fresh video.
  rematchOfId String?
  rematchOf   Challenge?  @relation("RematchChain", fields: [rematchOfId], references: [id], onDelete: SetNull)
  rematches   Challenge[] @relation("RematchChain")

  expiresAt DateTime
  status    ChallengeStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  @@unique([challengerId, challengedId, reviewId, status])
  @@index([creatorId])
  @@index([challengerId])
  @@index([challengedId])
  @@index([reviewId])
  @@index([status, expiresAt])
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int       @default(0)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId, score])
  @@index([userId])
}

enum ChallengeStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ChallengeType {
  GENERIC
  PER_VIDEO
}
